# Mock backend (MSW + Socket.IO binding). Enabled by default, including the demo build.
VITE_MOCKS=true
# Default mock scenario (see README > Mock scenarios). Overridable at runtime via ?scenario= or the Mocks panel.
VITE_MOCK_SCENARIO=default
# REST base URL and Socket.IO endpoint (intercepted by MSW when mocks are on).
VITE_API_URL=/api
VITE_SOCKET_URL=wss://realtime.kurio.test
